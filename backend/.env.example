# Cloud providers
VOYAGE_API_KEY=key
DEEPSEEK_API_KEY=key
COHERE_API_KEY=key
GEMINI_API_KEY=key
# Optional: only required for the premium decoupage harness when --provider openai is used.
OPENAI_API_KEY=key

# Active models
VOYAGE_MULTIMODAL_MODEL=voyage-multimodal-3.5
VOYAGE_MULTIMODAL_DIMENSION=1024
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
ENABLE_COHERE_RERANK=true
COHERE_RERANK_MODEL=rerank-v4.0-pro
GEMINI_VISION_MODEL=gemini-3-flash-preview
OPENAI_DECOUPAGE_MODEL=gpt-5.5

# Optional overrides
# KB_PERSIST_DIR=./chroma_db
# KB_UPLOAD_DIR=./uploads
# CHAT_STATE_DB=./app_state/chat.sqlite
# KB_COLLECTION=dante_multimodal_kb
# CORS_ORIGINS=http://localhost:5173,app://obsidian.md
# LOG_LEVEL=INFO
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_DECOUPAGE_REASONING_EFFORT=high
# OPENAI_DECOUPAGE_TEXT_VERBOSITY=high
# OPENAI_DECOUPAGE_MAX_OUTPUT_TOKENS=8192
# OPENAI_DECOUPAGE_MAX_IMAGE_EDGE=1280
# OPENAI_DECOUPAGE_JPEG_QUALITY=82
