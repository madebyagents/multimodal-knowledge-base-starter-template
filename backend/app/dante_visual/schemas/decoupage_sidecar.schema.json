          "lens": {
            "type": "string",
            "enum": [
              "solo",
              "dp",
              "art_cast",
              "critic",
              "judge",
              "confrontador"
            ]
          },
          "frame_type": {
            "type": "string",
            "enum": [
              "film_frame",
              "still_photograph",
              "animation_frame",
              "comic_panel",
              "artwork",
              "architecture",
              "design",
              "unknown"
            ]
